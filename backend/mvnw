#!/usr/bin/env sh
# Small Maven bootstrapper so a local Maven installation is optional.
set -eu
MAVEN_VERSION="3.9.11"
BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CACHE_ROOT="${MAVEN_USER_HOME:-${HOME}/.m2}/wrapper/dists"
MAVEN_HOME="$CACHE_ROOT/apache-maven-$MAVEN_VERSION"
MAVEN_BIN="$MAVEN_HOME/bin/mvn"
if [ ! -x "$MAVEN_BIN" ]; then
  mkdir -p "$CACHE_ROOT"
  TMP_DIR=$(mktemp -d)
  trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM
  ARCHIVE="$TMP_DIR/apache-maven-$MAVEN_VERSION-bin.zip"
  URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.zip"
  echo "Downloading Apache Maven $MAVEN_VERSION (first run only)..."
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 2 "$URL" -o "$ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ARCHIVE" "$URL"
  else
    echo "Please install curl or wget, or install Maven directly." >&2
    exit 1
  fi
  unzip -q "$ARCHIVE" -d "$TMP_DIR"
  rm -rf "$MAVEN_HOME"
  mv "$TMP_DIR/apache-maven-$MAVEN_VERSION" "$MAVEN_HOME"
fi
exec "$MAVEN_BIN" -f "$BASE_DIR/pom.xml" "$@"
