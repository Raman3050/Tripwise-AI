# Copy this to .env or set these as environment variables.
# For Render.com deployment, set these in the Render Dashboard > Environment tab.

GEOAPIFY_API_KEY=your_geoapify_key_here
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# For local dev:
# FRONTEND_ORIGIN=http://localhost:5173

# For production (comma-separated — include BOTH your Vercel URL and localhost for dev):
# FRONTEND_ORIGIN=https://your-app.vercel.app,http://localhost:5173

PORT=8080
